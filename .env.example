# ============================================================
# CDAO Assistant - Variables de entorno (PLACEHOLDERS)
# Copia este archivo a `.env` y completa con tus valores.
# NUNCA commitees el archivo `.env` real.
# ============================================================

# ---- Selector de carril de datos ----
# mock = fixtures ficticios (por defecto, seguro para demo/video)
# live = APIs reales (Google + Azure DevOps)
DATA_PROVIDER=mock

# ---- Google Workspace (OAuth, SOLO LECTURA) ----
# Ruta al client_secret descargado desde Google Cloud Console.
# Scopes usados: gmail.readonly, calendar.readonly
GOOGLE_CLIENT_SECRET_FILE=./client_secret.json
GOOGLE_TOKEN_FILE=./token.json
GMAIL_MAX_RESULTS=25
CALENDAR_MAX_RESULTS=25

# ---- Azure DevOps (PAT, permisos minimos de LECTURA) ----
AZDO_ORG_URL=https://dev.azure.com/tu-organizacion
AZDO_PROJECT=tu-proyecto
AZDO_PAT=coloca-aqui-tu-personal-access-token
AZDO_MAX_RESULTS=50

# ---- Seguridad ----
# Redactar PII (correos, nombres) en logs y salidas persistidas.
REDACT_PII=true
